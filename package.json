{
  "name": "eventbiz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c teal,magenta \"npm run api\" \"vite\"",
    "api": "json-server db.json --port 3001",
